
// Define pins
const int ldrPin = A0;       // Analog pin
const int ledPin = 9;        // Digital pin connected to the LED

int ldrValue = 0;            // Variable to store LDR readings
const int threshold = 500;   // Light threshold for turning the LED ON/OFF

void setup()
{
  pinMode(ledPin, OUTPUT);   // Set LED pin as output
  Serial.begin(9600);        // Initialize serial monitor for debugging
}

void loop()
{
  ldrValue = analogRead(ldrPin);  // Read LDR value (0-1023)

  Serial.print("LDR Value: ");
  Serial.println(ldrValue);       // Display LDR value on Serial Monitor

  if (ldrValue < threshold)
  {
    // Turn on the LED in darkness
    digitalWrite(ledPin, HIGH);
    Serial.println("LED ON");
  }
  else
  {
    // Turn off the LED in bright light
    digitalWrite(ledPin, LOW);
    Serial.println("LED OFF");
  }

  delay(200);  // Delay for stability
}
